# ============================================================
# ROS MES 后端环境配置文件
# 部署到新机器时，将此文件复制为 mes_web/ros_mes_hou/.env
# ============================================================

# ---- 项目基本配置 ----
PROJECT_NAME=ROS MES Backend

# API 前缀（默认 /api，前端请求需一致）
API_STR=/api

# ---- 数据库配置 ----
# SQLite 数据库文件路径，默认指向项目根目录的 ros_database.db
# 如使用绝对路径，请使用 sqlite:///C:/path/to/ros_database.db 格式
DATABASE_URL=sqlite:///../ros_database.db

# ---- CORS 跨域配置 ----
# 多个源用逗号分隔，如 http://localhost:5173,http://192.168.1.100:5173
# 生产环境建议指定具体域名，不要用 *
BACKEND_CORS_ORIGINS=*

# ---- ROS Bridge 配置 ----
# rosbridge_websocket 的 WebSocket 地址（ROS1/ROS2 通用）
# 默认本地 9010 端口，如 ROS 在另一台机器上需修改 IP
ROSBRIDGE_URL=ws://127.0.0.1:9010

# ROS 版本适配：1/ros1 = ROS1 适配器（默认），2/ros2 = ROS2 适配器
# 详见 app/ros/profile.py 与《接口字段文档》第 12 节
ROS_VERSION=1

# 模块确认会话式握手的回执等待上限（秒）。
# ROS 端等宣告窗口 30s（含操作员上电）+ 确认重试，必须 ≥35s，否则模块确认必然 502
ROS_MODULE_CONFIRM_ACK_WAIT_S=35

# 业务模块号到 ROS 下位机 SEG 的显式映射。
# 格式：JSON 对象，例如 {"17": 0, "18": 1}。
# 不配置目标模块映射时，模块确认接口拒绝下发，禁止把业务 module_id 直接当作 SEG。
ROS_MODULE_SEG_MAP={"17": 0}

# 点云三视图服务地址（data_process_node 内置的 Flask，默认同机 5000 端口）。
# 联调时 ROS 在另一台机器/虚拟网络上，改成 http://<ROS 端 IP>:5000
POINTCLOUD_VIEW_BASE_URL=http://127.0.0.1:5000

# ROS 端话题名如与默认值不同，可用 ROS_TOPIC_<键名> 覆盖，例如：
# ROS_TOPIC_DRAWING_PATH=/control/frontend_pointcloud_topic

# ROS 通信默认模块 ID
ROS_COMM_MODULE_ID=17

# ---- JWT 认证配置 ----
# JWT 密钥（部署时务必修改为随机字符串！）
# 生成命令：python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-change-this-in-production-please

# JWT 算法
ALGORITHM=HS256

# Token 过期时间（分钟）
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---- 服务配置 ----
# 后端监听地址
HOST=0.0.0.0

# 后端监听端口
PORT=8000

# 工作进程数（生产环境建议 CPU 核心数）
WORKERS=1

# ---- 上传配置 ----
# 上传文件最大大小（MB）
MAX_UPLOAD_SIZE=50

# 上传目录（相对后端 app/ 目录）
UPLOAD_DIR=uploads
